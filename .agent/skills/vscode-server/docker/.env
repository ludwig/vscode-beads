# Config for the openvscode-server (Docker) dev harness.
# Read by both `just dev …` and `docker compose`. Override per-invocation with
# shell env (e.g. `BEADS_PROJECTS_DIR=~/beads just dev up`) — shell env wins.

# Parent directory of beads repos, mounted at /home/workspace/projects. The
# entrypoint scans it for `*/.beads` and generates a multi-root workspace +
# `beads.projects` setting, so EVERY repo under it shows up in the extension's
# project switcher. Mix embedded and server-mode repos here to test switching.
# Empty → `just dev` recipes default to $HOME/beads; standalone `docker compose`
# requires it set explicitly.
BEADS_PROJECTS_DIR=

# Host port mapped to the container's openvscode-server.
OVS_HOST_PORT=3000

# Container arch for bd + the base image. arm64 on Apple Silicon.
BD_ARCH=arm64

# Go image used to build bd natively (CGO) — see build-bd.sh.
GO_IMAGE=golang:1.26-bookworm
