# Config for the openvscode-server (Docker) dev harness.
# Read by both `just dev …` and `docker compose`. Override per-invocation with
# shell env (e.g. `BEADS_WORKSPACE=~/beads/vs just dev up`) — shell env wins.

# Beads repo opened as the workspace. MUST be an embedded-mode repo so the
# in-container bd works (server-mode hits the documented socket blocker).
# `mkdir -p /tmp/bd-test && cd /tmp/bd-test && bd init` makes a throwaway one.
BEADS_WORKSPACE=/tmp/bd-test

# Host port mapped to the container's openvscode-server.
OVS_HOST_PORT=3000

# Container arch for bd + the base image. arm64 on Apple Silicon.
BD_ARCH=arm64

# Go image used to build bd natively (CGO) — see build-bd.sh.
GO_IMAGE=golang:1.26-bookworm
