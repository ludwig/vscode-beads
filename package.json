{
  "name": "vscode-beads-pm",
  "displayName": "Beads (ludwig)",
  "description": "VS Code extension for managing Beads issues",
  "version": "0.23.0",
  "publisher": "ludwig",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "dist/**",
    "resources/**",
    "docs/images/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ludwig/vscode-beads-pm"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "beads",
    "issues",
    "project management",
    "dashboard"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beads",
          "title": "Beads",
          "icon": "resources/beads-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "beadsBottomPanel",
          "title": "Beads",
          "icon": "resources/beads-icon.svg"
        }
      ]
    },
    "views": {
      "beads": [
        {
          "type": "webview",
          "id": "beadsProjectSwitcher",
          "name": "Repository",
          "visibility": "visible"
        },
        {
          "type": "webview",
          "id": "beadsDetails",
          "name": "Details",
          "visibility": "visible"
        }
      ],
      "beadsBottomPanel": [
        {
          "type": "webview",
          "id": "beadsPanelShell",
          "name": "Beads",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "beads.switchProject",
        "title": "Beads: Switch Project",
        "icon": "$(folder)"
      },
      {
        "command": "beads.openBeadsPanel",
        "title": "Beads: Show Issues Panel",
        "icon": "$(list-unordered)"
      },
      {
        "command": "beads.pickReadyBead",
        "title": "Beads: Pick Ready Bead",
        "icon": "$(rocket)"
      },
      {
        "command": "beads.openBeadDetails",
        "title": "Beads: Open Issue Details",
        "icon": "$(file-text)"
      },
      {
        "command": "beads.navigateBack",
        "title": "Beads: Back",
        "icon": "$(arrow-left)",
        "enablement": "beads.canNavigateBack"
      },
      {
        "command": "beads.navigateForward",
        "title": "Beads: Forward",
        "icon": "$(arrow-right)",
        "enablement": "beads.canNavigateForward"
      },
      {
        "command": "beads.refresh",
        "title": "Beads: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "beads.copyBeadId",
        "title": "Beads: Copy Issue ID",
        "icon": "$(copy)",
        "enablement": "beads.hasSelectedBead"
      },
      {
        "command": "beads.openBeadAsDocument",
        "title": "Beads: Open Issue as Document (Claude Code context)",
        "icon": "$(file)",
        "enablement": "beads.hasSelectedBead"
      },
      {
        "command": "beads.createIssue",
        "title": "Beads: New Issue",
        "icon": "$(add)"
      },
      {
        "command": "beads.initRepository",
        "title": "Beads: Initialize Repository...",
        "icon": "$(repo-create)"
      },
      {
        "command": "beads.openBeadInTab",
        "title": "Beads: Open Issue in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "beads.openIssuesInTab",
        "title": "Beads: Open Issues in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "beads.openDashboardInTab",
        "title": "Beads: Open Dashboard in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "beads.openGraphInTab",
        "title": "Beads: Open Graph in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "beads.openKanbanInTab",
        "title": "Beads: Open Kanban in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "beads.openTreeInTab",
        "title": "Beads: Open Tree in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "beads.openNewIssueInTab",
        "title": "Beads: New Issue (Editor Tab)",
        "icon": "$(empty-window)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "beads.createIssue",
          "when": "view == beadsProjectSwitcher",
          "group": "navigation@0"
        },
        {
          "command": "beads.openNewIssueInTab",
          "when": "view == beadsProjectSwitcher",
          "group": "navigation@1"
        },
        {
          "command": "beads.refresh",
          "when": "view == beadsProjectSwitcher",
          "group": "navigation@2"
        },
        {
          "command": "beads.navigateBack",
          "when": "view == beadsDetails",
          "group": "navigation@0"
        },
        {
          "command": "beads.navigateForward",
          "when": "view == beadsDetails",
          "group": "navigation@1"
        },
        {
          "command": "beads.copyBeadId",
          "when": "view == beadsDetails",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Beads",
      "properties": {
        "beads.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional Beads projects to show beyond the open workspace folders. Each entry is a path to a project root or its .beads directory. Supports ${env:VAR} placeholders."
        },
        "beads.pathToBd": {
          "type": "string",
          "default": "bd",
          "description": "Path to the bd CLI executable. Supports ${env:VAR} placeholders."
        },
        "beads.refreshInterval": {
          "type": "number",
          "default": 3000,
          "description": "Polling interval in milliseconds for Dolt change detection (0 to disable)"
        },
        "beads.renderMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Render markdown in description, design notes, and other text fields"
        },
        "beads.highlightFavorites": {
          "type": "boolean",
          "default": true,
          "description": "Highlight favorited (starred) beads in table views with a subtle accent. In the Favorites filter this also distinguishes starred beads from the relatives that tag along (their dependency neighbors)."
        },
        "beads.userId": {
          "type": "string",
          "default": "",
          "description": "Your user ID for 'Assign to me'. Supports ${env:VAR} placeholders (e.g., ${env:USER}). Defaults to $USER if not set."
        },
        "beads.tooltipHoverDelay": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "Delay in milliseconds before showing bead description tooltip on hover. Set to 0 to disable tooltips."
        },
        "beads.autoSeedActiveBead": {
          "type": "boolean",
          "default": false,
          "description": "Experimental. When a bead opened as an editor tab gains focus, open its content as a companion virtual 'bead:' document beside it (keeping focus on the bead tab) so Claude Code's IDE integration seeds the active bead into your session automatically. Off by default: it adds a second, companion tab. Enable only if you want auto-seeding via the companion document."
        }
      }
    }
  },
  "scripts": {
    "compile": "bun run compile:extension && bun run compile:webview && bun run gen:buildinfo",
    "compile:quiet": "bun run compile:extension:quiet && bun run compile:webview:quiet && bun run gen:buildinfo",
    "gen:buildinfo": "bun scripts/gen-build-info.mjs",
    "compile:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "compile:extension:quiet": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --log-level=error",
    "compile:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview/main.js --format=iife --platform=browser --target=es2020 --loader:.tsx=tsx --loader:.ts=ts --loader:.css=css --loader:.svg=text --define:process.env.NODE_ENV=\\\"production\\\"",
    "compile:webview:quiet": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview/main.js --format=iife --platform=browser --target=es2020 --loader:.tsx=tsx --loader:.ts=ts --loader:.css=css --loader:.svg=text --define:process.env.NODE_ENV=\\\"production\\\" --log-level=error",
    "watch": "concurrently \"bun run watch:extension\" \"bun run watch:webview\"",
    "watch:extension": "bun run compile:extension -- --watch --sourcemap",
    "watch:webview": "bun run compile:webview -- --watch --sourcemap",
    "lint": "eslint src --ext ts,tsx",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "vscode:prepublish": "bun run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.10",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.10",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "mysql2": "^3.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
